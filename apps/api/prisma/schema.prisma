generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Fuel {
  GASOLINE
  ETHANOL
  FLEX
  DIESEL
  CNG
  ELECTRIC
  HYBRID
  OTHER
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @db.VarChar(100)
  email               String               @unique(map: "users_email_key") @db.VarChar(254)
  passwordHash        String               @map("password_hash") @db.Text
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  vehicle             Vehicle?
  earnings            Earning[]
  expenses            Expense[]
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Vehicle {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique(map: "vehicles_user_id_key") @map("user_id") @db.Uuid
  brand     String   @db.VarChar(100)
  model     String   @db.VarChar(100)
  year      Int
  fuel      Fuel
  plate     String?  @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("vehicles")
}

model Platform {
  id        String    @id @db.VarChar(20)
  name      String    @unique(map: "platforms_name_key") @db.VarChar(30)
  sortOrder Int       @map("sort_order")
  earnings  Earning[]

  @@map("platforms")
}

model ExpenseCategory {
  id        String    @id @db.VarChar(30)
  name      String    @unique(map: "expense_categories_name_key") @db.VarChar(30)
  sortOrder Int       @map("sort_order")
  expenses  Expense[]

  @@map("expense_categories")
}

model Earning {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  date       DateTime @db.Date
  platformId String   @map("platform_id") @db.VarChar(20)
  amount     Decimal  @db.Decimal(65, 2)
  rides      Int
  hours      Decimal  @db.Decimal(4, 2)
  kilometers Decimal  @db.Decimal(65, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, date(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "earnings_user_date_created_id_idx")
  @@index([platformId], map: "earnings_platform_id_idx")
  @@map("earnings")
}

model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  date        DateTime        @db.Date
  categoryId  String          @map("category_id") @db.VarChar(30)
  amount      Decimal         @db.Decimal(65, 2)
  description String?         @db.VarChar(500)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category    ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, date(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "expenses_user_date_created_id_idx")
  @@index([categoryId], map: "expenses_category_id_idx")
  @@map("expenses")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique(map: "auth_sessions_refresh_token_hash_key") @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "password_reset_tokens_token_hash_key") @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId], map: "password_reset_tokens_user_id_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
}
