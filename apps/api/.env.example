# Use a mesma senha do .env da raiz; faça URL-encode de caracteres especiais.
DATABASE_URL=postgresql://driverfin:change-me-local-only@localhost:5433/driverfin
# Em produção, use a URL privada fornecida pelo provedor e o modo TLS exigido por ele
# (por exemplo, `?sslmode=require` quando documentado pelo serviço).
# Reservado ao harness da próxima fase; nunca reutilizar o banco driverfin.
TEST_DATABASE_URL=postgresql://driverfin:change-me-local-only@localhost:5433/driverfin_test
PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
# Variáveis das fases de autenticação/recuperação; ainda não usadas pela Fundação.
# JWT_ACCESS_SECRET deve ter pelo menos 32 bytes aleatórios; não use o placeholder.
JWT_ACCESS_SECRET=replace-with-a-random-secret-before-authentication
JWT_ISSUER=driverfin-api
JWT_AUDIENCE=driverfin-web
RESEND_API_KEY=replace-with-resend-api-key-before-password-recovery
RESEND_FROM=DriverFin <replace-with-verified-sender@example.com>
