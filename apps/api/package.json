{
  "name": "@driverfin/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "npm run db:generate && nest build",
    "start:prod": "node dist/main.js",
    "start:e2e": "npm run test:compile && node .test-dist/test/fixtures/e2e-main.js",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0",
    "db:dev": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:compile": "tsc -p tsconfig.test.json",
    "test:unit": "npm run test:compile && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.mjs --selectProjects unit --runInBand",
    "test:foundation": "npm run test:compile && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.mjs --selectProjects foundation --runInBand",
    "test:integration": "npm run test:compile && node .test-dist/test/integration/prepare-database.js && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.mjs --selectProjects integration --runInBand"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.3",
    "@types/express": "5.0.5",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "eslint": "10.10.0",
    "jest": "30.5.1",
    "supertest": "7.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "17.4.2",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "resend": "6.28.1",
    "rxjs": "7.8.2"
  }
}
